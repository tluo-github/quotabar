{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // 正式地址 app.quotlet.com；workers.dev 先留着，旧版本的开发版还连着它
  "routes": [{ "pattern": "app.quotlet.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  // 网站静态文件；/api、/auth、/login 先交给 Worker 处理
  "assets": {
    "directory": "./web/static",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/login"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quotabar",
      "database_id": "68054cea-7f9b-4f20-8a08-3a3ecd469794",
      "migrations_dir": "migrations"
    }
  ],
  // 每个用户一个 UserHub：WebSocket 广播、二期的指令队列（免费套餐只能用 SQLite 版 DO）
  "durable_objects": {
    "bindings": [{ "name": "USER_HUB", "class_name": "UserHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub"] }],
  // 每天清理过期数据
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
